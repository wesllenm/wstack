{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "wstack:lead",
  "model": "opus",
  "worktree": {
    "baseRef": "head"
  },
  "extraKnownMarketplaces": {
    "wstack": {
      "source": {
        "source": "github",
        "repo": "wesllenm/wstack",
        "ref": "{{WSTACK_REF}}"
      }
    }
  },
  "enabledPlugins": {
    "wstack@wstack": true
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://127.0.0.1:4318/v1/metrics",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://127.0.0.1:4318/v1/logs",
    "OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false"
  },
  "permissions": {
    "deny": [
      "Edit(./.gitignore)",
      "Edit(./**/.gitignore)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/appsettings.*.local.json)",
      "Read(./.claude/settings.local.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git checkout .:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(kubectl delete:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(npm publish:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(cargo publish:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Edit(./.git/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.docker/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/plugins/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.kube/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.nuget/NuGet/**)"
    ],
    "ask": [
      "Bash(claude --cloud:*)",
      "Bash(rm -rf:*)",
      "Bash(docker builder prune:*)",
      "Bash(kubectl apply:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/risk.conf)",
      "Edit(./.claude/scripts/**)",
      "Edit(./**/.claude/hooks/**)",
      "Edit(./**/.claude/settings.json)",
      "Edit(./**/.claude/risk.conf)",
      "Edit(./**/.claude/scripts/**)",
      "Edit(./.claude/cloud/**)",
      "Edit(./.claude/.verify-ok)",
      "Edit(./.claude/.session/checkpoint-ok-*)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.mcp.json)"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "Bash(git status:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose down)",
      "Bash(docker info *)",
      "Bash(docker image inspect *)",
      "Bash(docker volume ls *)",
      "Bash(docker volume inspect *)",
      "Bash(curl -sS \"$HTTPS_PROXY/__agentproxy/status\")",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin task/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push -u origin ccr-*)"
    ]
  }
}
