      "Edit(~/.docker/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/plugins/**)"
    ],
    "ask": [
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/risk.conf)",
      "Edit(./.claude/scripts/**)",
      "Edit(./**/.claude/hooks/**)",
      "Edit(./**/.claude/settings.json)",
      "Edit(./**/.claude/risk.conf)",
      "Edit(./**/.claude/scripts/**)",
      "Edit(./.claude/cloud/**)",
      "Edit(./.claude/.verify-ok)",
      "Edit(./.claude/.session/checkpoint-ok-*)",
      "Edit(./.github/workflows/**)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.mcp.json)"
    ]
  }
}
